# Mitm-Archiver Configuration
# Copy to .env for configuration

# Cache directory (required)
# Local dev: ./data
# Production: /var/lib/mitm-archiver/data
CACHE_DIR=./data

# Listen port (required)
# Local dev: 8080
# Production: 42424
LISTEN_PORT=8080

# Certificates directory (required)
# Mitmproxy stores generated SSL certificates here
# Local dev: ./certs
# Production: /var/lib/mitm-archiver/certs
CERTS_DIR=./certs

# Proxy authentication (optional)
# Format: username:password
# Local dev: leave empty for no auth
# Production: set strong credentials
#PROXY_AUTH=username:securepassword
