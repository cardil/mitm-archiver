# Mitm-Archiver Configuration
#
# This file is OPTIONAL for local dev and Docker Compose (they use defaults).
# This file is REQUIRED for Quadlet generation (make quadlet).
#
# Copy to .env to customize:
#   cp .env.example .env
#   vi .env

# Cache directory
# Default: ./data
# Production: /var/lib/mitm-archiver/data
CACHE_DIR=./data

# Listen port
# Default: 8080
# Production: 42424
LISTEN_PORT=8080

# Certificates directory
# Mitmproxy stores generated SSL certificates here
# Default: ./certs
# Production: /var/lib/mitm-archiver/certs
CERTS_DIR=./certs

# Proxy authentication (optional, no default)
# Format: username:password
# Local dev: leave commented out for no auth
# Production: uncomment and set strong credentials
#PROXY_AUTH=username:securepassword
